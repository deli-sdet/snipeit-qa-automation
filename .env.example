# Copy to .env and fill in. Never commit .env.
# Full descriptions: docs/05-test-data-and-environment.md

TEST_ENV=demo
BASE_URL=https://demo.snipeitapp.com
API_BASE_URL=https://demo.snipeitapp.com/api/v1

SNIPEIT_USERNAME=admin
SNIPEIT_PASSWORD=password
# Personal access token (Account > Manage API Keys). Leave empty to skip API/integration tests.
SNIPEIT_API_TOKEN=

# Optional non-admin user for permission tests (controlled env only)
LIMITED_USERNAME=
LIMITED_PASSWORD=

TEST_PREFIX=QA-TA
# RUN_ID defaults to CI_PIPELINE_ID in CI or a timestamp locally
RUN_ID=

DEFAULT_MODEL_NAME=Macbook Pro 13"
DEFAULT_STATUS_NAME=Ready to Deploy
CHECKOUT_USER_NAME=
DEFAULT_LOCATION_NAME=

CLEANUP=true
WORKERS=2
RETRIES=
HEADLESS=true

# Controlled environment only (Part 4) — not used against the public demo
DB_HOST=
DB_PORT=3306
DB_NAME=snipeit
DB_USER=
DB_PASSWORD=
